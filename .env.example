# Copy to .env.local for local development. Never commit real values. Names only; see HOSTING.md.

# Neon Auth of the branch this app talks to (Neon Console > Branch > Auth > Configuration). Server only.
# Without both values the app runs locally without login (anonymous), on a host it refuses (fail closed).
NEON_AUTH_BASE_URL=...
# At least 32 random characters, for example: openssl rand -base64 32. Server only, one per environment.
NEON_AUTH_COOKIE_SECRET=...

# PostgreSQL connection of the app: the pooled Neon host (-pooler) of the same branch, ?sslmode=require,
# ideally as the runtime role goal_clicker_app (scripts/migration/runtime-role.sql). Server only.
DATABASE_URL=...

# Optional: connections per server instance (default 3, at most 10).
# DATABASE_POOL_MAX=...

# Optional: seconds a verified session is reused per server instance before Neon Auth is asked again (default 30, max 60).
# AUTH_SESSION_CACHE_SECONDS=...

# TEMPORARY recovery bridge for the six original username accounts (docs/neon-netlify-migration.md). Server only.
# LEGACY_SUPABASE_URL=...
# LEGACY_SUPABASE_PUBLISHABLE_KEY=...

# Optional: refuse anonymous play without login settings even outside a host (Netlify and Vercel do this automatically).
# AUTH_REQUIRED=...

# Only for npm run test:db and test:account: an empty scratch database, never a real one.
# TEST_DATABASE_URL=...
