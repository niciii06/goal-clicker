# Copy to .env.local for local development. Never commit real values.

# Supabase project URL and publishable key (Project Settings > API Keys). Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection of the app. On Vercel use the Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DATABASE-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Optional: refuse anonymous play when the Supabase keys are missing (Vercel does this automatically).
# AUTH_REQUIRED=1

# Only for npm run test:db: an empty scratch database, never the production one.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/goalclicker_test
